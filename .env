# ==============================================================================
# GraphRAG Coordinator + Streamlit Personas — .env (simplified for resolver setup)
# ==============================================================================

# ------------------------------------------------------------------------------ 
# 🔌 Coordinator (backend)
# ------------------------------------------------------------------------------ 
COORD_URL=http://127.0.0.1:8000
COORD_PORT=8000

# ------------------------------------------------------------------------------
# 🤖 LLM / Ollama (Coordinator-side settings)
# ------------------------------------------------------------------------------
OLLAMA_BASE=http://127.0.0.1:11434
PERSONA_MODEL=dolphin-llama3:8b
PERSONA_TEMPERATURE=0.1

# ------------------------------------------------------------------------------ 
# 🧬 Personas data
# ------------------------------------------------------------------------------ 
# Folder containing persona JSONs (e.g., personas/eeva.json, personas/cindy.json)
PERSONA_DIR=personas

# ------------------------------------------------------------------------------ 
# 🎨 Visual assets
# ------------------------------------------------------------------------------ 
# Global app brand logo (used in header/UI)
APP_LOGO_PATH=ui/images/app_logo.png

# User avatar shown in chat bubbles
# Can be an emoji or image path; optional
USER_AVATAR=ui/images/user_avatar.png

# ------------------------------------------------------------------------------ 
# ✨ UI behavior toggles
# ------------------------------------------------------------------------------ 
UI_CLEAR_ON_SWITCH=false
UI_ENABLE_BALLOONS=true
UI_ENABLE_CARD_GLOW=true

# ------------------------------------------------------------------------------
# 🔍 Brave MCP Server (Web Search Integration)
# ------------------------------------------------------------------------------
# Brave Search API key for MCP server
BRAVE_API_KEY=BSAHt0pS1n4rjFHn3chw4ISI6t6GC1C

# MCP transport protocol (stdio for Docker)
BRAVE_MCP_TRANSPORT=stdio

# Search configuration
BRAVE_SEARCH_TIMEOUT=10
BRAVE_MAX_RESULTS=5
BRAVE_SAFESEARCH=moderate

# Enable web search for these persona rarities (comma-separated: rare,epic,legendary)
BRAVE_ENABLED_RARITIES=rare,epic,legendary

# ------------------------------------------------------------------------------
# 🧰 MCP routing (legacy - for future expansion)
# ------------------------------------------------------------------------------
# These are informational; actual routing is handled by persona rarity.
EEVA_ALLOWED_MCP=chat,graphrag,brave
CINDY_ALLOWED_MCP=chat,brave

# ------------------------------------------------------------------------------ 
# 📝 Notes
# - Persona-specific image/emoji vars (EEVA_LOGO, EEVA_AVATAR, etc.) are no longer needed.
# - Each persona JSON may define its own image/avatar/logo/bg/emoji fields.
# - Built-in defaults in src/shared/persona_assets.py ensure the app works even with no images.
# ------------------------------------------------------------------------------
