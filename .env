# ==============================================================================
# GraphRAG Coordinator + Streamlit Personas — .env (simplified for resolver setup)
# ==============================================================================

# ------------------------------------------------------------------------------ 
# 🔌 Coordinator (backend)
# ------------------------------------------------------------------------------ 
COORD_URL=http://127.0.0.1:8000
COORD_PORT=8000

# ------------------------------------------------------------------------------
# 🤖 LLM / Ollama (Coordinator-side settings)
# ------------------------------------------------------------------------------
OLLAMA_BASE=http://127.0.0.1:11434
PERSONA_MODEL=nchapman/gemma-2-9b-it-abliterated:9b
PERSONA_TEMPERATURE=0.9

# ------------------------------------------------------------------------------ 
# 🧬 Personas data
# ------------------------------------------------------------------------------ 
# Folder containing persona JSONs (e.g., personas/eeva.json, personas/cindy.json)
PERSONA_DIR=personas

# ------------------------------------------------------------------------------ 
# 🎨 Visual assets
# ------------------------------------------------------------------------------ 
# Global app brand logo (used in header/UI)
APP_LOGO_PATH=ui/images/app_logo.png

# User avatar shown in chat bubbles
# Can be an emoji or image path; optional
USER_AVATAR=ui/images/user_avatar.png

# ------------------------------------------------------------------------------ 
# ✨ UI behavior toggles
# ------------------------------------------------------------------------------ 
UI_CLEAR_ON_SWITCH=false
UI_ENABLE_BALLOONS=true
UI_ENABLE_CARD_GLOW=true

# ------------------------------------------------------------------------------
# 🔍 Brave MCP Server (Web Search Integration)
# ------------------------------------------------------------------------------
# Brave Search API key for MCP server
BRAVE_API_KEY=BSAHt0pS1n4rjFHn3chw4ISI6t6GC1C

# MCP transport protocol (stdio for Docker)
BRAVE_MCP_TRANSPORT=stdio

# Search configuration
BRAVE_SEARCH_TIMEOUT=10
BRAVE_MAX_RESULTS=5
BRAVE_SAFESEARCH=moderate

# Enable web search for these persona rarities (comma-separated: rare,epic,legendary)
BRAVE_ENABLED_RARITIES=rare,epic,legendary

# ------------------------------------------------------------------------------
# 🗄️ MongoDB MCP Server (Crypto Trading Data Integration)
# ------------------------------------------------------------------------------
# MongoDB Atlas connection string for crypto cluster
MONGODB_URI=mongodb+srv://Eeva_Admin:hNsnGOz02KptIQTX@crypto-cluster.vhrcr17.mongodb.net/btc_data?retryWrites=true&w=majority

# MCP configuration
MONGODB_TIMEOUT=30
MONGODB_MAX_RESPONSE_BYTES=100000

# Cache TTLs (seconds)
MONGODB_CACHE_CURRENT_PRICE=60
MONGODB_CACHE_HISTORICAL=3600
MONGODB_CACHE_TECHNICAL=60
MONGODB_CACHE_TRADING=300

# Enable MongoDB MCP for these persona rarities (epic,legendary only)
MONGODB_ENABLED_RARITIES=epic,legendary

# Feature flag
MONGODB_ENABLED=true

# ------------------------------------------------------------------------------
# 🧠 Memory & RAG Configuration (Phase 3 Advanced Memory)
# ------------------------------------------------------------------------------
# Ollama embedding model for semantic search (RAG)
# Run: ollama pull nomic-embed-text
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest

# Number of messages before triggering auto-summarization
MEMORY_SUMMARIZATION_INTERVAL=30

# Number of messages before triggering fact extraction for user profiles
MEMORY_FACT_EXTRACTION_INTERVAL=10

# ------------------------------------------------------------------------------
# 🎛️ LLM Temperature Overrides (Operation-Specific)
# ------------------------------------------------------------------------------
# First-person voice rewrites
OLLAMA_TEMP_REWRITE=0.2

# Conversation summarization
OLLAMA_TEMP_SUMMARIZATION=0.3

# Fact extraction for user profiles
OLLAMA_TEMP_FACT_EXTRACTION=0.3

# ------------------------------------------------------------------------------
# 🐙 GitHub MCP Plugin
# ------------------------------------------------------------------------------
# Personal Access Token for plugin:github:github MCP server
# Required scopes: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=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

# ------------------------------------------------------------------------------
# 🔐 Authentication
# ------------------------------------------------------------------------------
# Set to false to skip auth in local dev (no Google OAuth needed)
AUTH_REQUIRED=false

# ------------------------------------------------------------------------------
# ⚡ Jupiter Wallet MCP (Solana Trading — archon personas only)
# ------------------------------------------------------------------------------
# Enable wallet features (creates SQLite repos, registers /wallet routes)
JUPITER_ENABLED=true

# Docker image for Jupiter MCP server (built from araa47/jupiter-mcp)
JUPITER_MCP_IMAGE=localhost/jupiter-mcp:latest

# Solana RPC endpoint — devnet by default for safety; switch to mainnet when ready
SOLANA_RPC_URL=https://api.devnet.solana.com

# Slippage tolerance in basis points (50 bps = 0.5%)
JUPITER_SLIPPAGE_BPS=50

# Jupiter MCP operation timeout in seconds
JUPITER_TIMEOUT=30

# Directory for autonomous strategy JSON files (like personas/)
STRATEGIES_DIR=strategies

# MongoDB URI for writing trade history (optional — leave blank to disable)
MONGODB_WRITE_URI=

# ------------------------------------------------------------------------------
# 📧 Email Trade Notifications (optional)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ------------------------------------------------------------------------------
# 📝 Notes
# - Persona-specific image/emoji vars (EEVA_LOGO, EEVA_AVATAR, etc.) are no longer needed.
# - Each persona JSON may define its own image/avatar/logo/bg/emoji fields.
# - Built-in defaults in src/shared/persona_assets.py ensure the app works even with no images.
# ------------------------------------------------------------------------------
