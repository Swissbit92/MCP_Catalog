# Copy to `.env` for the default (single-bot) instance, or `.env.<name>` for a
# second persona/bot: run it with EEVA_TG_INSTANCE=<name> (own token below, own
# launchd plist). Example live second instance: `.env.gwen` + EEVA_TG_INSTANCE=gwen.

# ─── Telegram bot ────────────────────────────────────────────────
# REUSE the existing E.E.V.A. notification bot token (same one eeva-dca /
# eeva-exec use for alerts). This is safe: those notifiers are send-only
# (sendMessage), and only ONE process may long-poll a token — this gateway is
# the sole poller, so there is no conflict. The bot must have NO webhook set.
# (A brand-new @BotFather token also works if you ever want a separate bot.)
# This token is a bearer secret — anyone holding it can act AS the bot; keep
# .env chmod 600. Note: reusing means alerts + chat share one Telegram thread.
TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated allowlist of numeric Telegram chat IDs permitted to talk to
# the bot. EVERY other chat is silently ignored (no reply). Find your own id by
# messaging @userinfobot. Add your wife's id here later to grant her access.
TG_ALLOWED_CHAT_IDS=123456789

# ─── NEPHILIM backend ────────────────────────────────────────────
# The nephilim FastAPI coordinator. MUST stay on loopback — the chat routes
# have no auth; the Telegram allowlist is the only security boundary. Never
# point this at a non-localhost address that is reachable from the network.
NEPHILIM_BASE_URL=http://127.0.0.1:8000

# Default persona key for chats with no explicit override below.
# E.E.V.A. = nephilim_eeva. Other keys: nephilim_nyx, nephilim_aurora,
# nephilim_solace, nephilim_cipher, nephilim_aegis, gojo.
EEVA_PERSONA_KEY=nephilim_eeva

# Optional per-chat persona overrides: "chat_id:persona_key" pairs, comma
# separated. Lets a second allowlisted person (e.g. your wife) talk to a
# DIFFERENT persona than the default. Leave empty to use EEVA_PERSONA_KEY for
# everyone. Example: TG_CHAT_PERSONAS=987654321:nephilim_nyx
TG_CHAT_PERSONAS=

# ─── Tuning (sane defaults; override only if needed) ─────────────
# Seconds to wait for a nephilim chat response. Local 24B at ~16 tok/s can take
# a while on long replies — keep this generous.
NEPHILIM_TIMEOUT_SECONDS=180

# How often to re-send the Telegram "typing…" chat action while generating.
# Telegram's indicator decays after ~5s, so keep this under 5.
TG_TYPING_INTERVAL_SECONDS=4.5

# Soft cap for a single outbound Telegram message. Hard Telegram limit is 4096;
# we split below this with headroom.
TG_MESSAGE_CHAR_LIMIT=4000

# DEBUG ONLY: set true to log raw message content (chat text is sensitive —
# leave false in production; default logs only chat_id + outcome).
TG_LOG_CONTENT=false
