<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eeva.telegram-gwen</string>

    <!--
        Second gateway instance: the Gwen NSFW persona on its OWN bot token.
        Same codebase/venv as com.eeva.telegram; EEVA_TG_INSTANCE=gwen selects
        the .env.gwen file + a per-instance flock (data/bot.gwen.lock), so the
        two long-pollers never collide. Calls the venv python DIRECTLY (never
        via bash — macOS TCC blocks bash launched by launchd).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway/venv/bin/python</string>
        <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway/bin/run_telegram_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway/logs/launchd-telegram-gwen.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway/logs/launchd-telegram-gwen.stderr.log</string>

    <!--
        SECURITY: no secrets in the plist (world-readable under
        ~/Library/LaunchAgents). EEVA_TG_INSTANCE is NOT a secret — it only
        names which .env.<instance> file to load; the Gwen bot token lives
        solely in .env.gwen (chmod 600).
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/swissbit./nephilim-ecosystem/nephilim/services/telegram-gateway/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>EEVA_TG_INSTANCE</key>
        <string>gwen</string>
    </dict>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
