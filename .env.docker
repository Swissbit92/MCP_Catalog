# =============================================================================
# MCP Coordinator - SQLite Edition Environment Configuration
# =============================================================================
# Optimized for local personal use with Docker Compose
# All data persists in ./data/ directory on your host machine
#
# For production multi-user deployment, see PRODUCTION_READINESS_PLAN.md
# =============================================================================

# =============================================================================
# Ollama LLM Configuration
# =============================================================================
# Model to use (must be pulled first: docker exec ai-companion-brain ollama pull <model>)
# Recommended models:
#   - llama3.1:8b-instruct-q5_0 (best persona quality + security refusals, 5.6GB) ← DEFAULT
#   - HammerAI/mythomax-l2:latest (NSFW-capable, #2 overall, good voice/expertise, 7.9GB) ← ALT
#   - nchapman/gemma-2-9b-it-abliterated:9b (uncensored, creative but zero safety refusals, 5.8GB)
#   - dolphin-llama3:8b (uncensored, fast but weakest pass rate, 4.7GB)
PERSONA_MODEL=llama3.1:8b-instruct-q5_0
PERSONA_MODEL_B=HammerAI/mythomax-l2:latest

# LLM sampling temperature
#   0.0-0.3 = Very consistent, factual
#   0.7-0.9 = Balanced creativity (recommended for AI companions)
#   1.0-1.5 = Highly creative, unpredictable
PERSONA_TEMPERATURE=0.9

# =============================================================================
# Web Search - Brave MCP (Optional)
# =============================================================================
# Get your FREE API key: https://brave.com/search/api/
# Leave empty to disable web search functionality
BRAVE_API_KEY=BSAHt0pS1n4rjFHn3chw4ISI6t6GC1C

# Maximum number of search results to return
BRAVE_MAX_RESULTS=5

# =============================================================================
# MongoDB MCP - Trading Data (Optional)
# =============================================================================
# MongoDB Atlas connection URI
# Leave empty to disable MongoDB integration
MONGODB_URI=mongodb+srv://Eeva_Admin:hNsnGOz02KptIQTX@crypto-cluster.vhrcr17.mongodb.net/btc_data?retryWrites=true&w=majority

# Enable/disable MongoDB functionality
MONGODB_ENABLED=true

# =============================================================================
# Memory & RAG Configuration (Phase 3 Features)
# =============================================================================
# Ollama embedding model for semantic search
# Must be pulled: docker exec ai-companion-brain ollama pull nomic-embed-text:latest
MEMORY_EMBEDDING_MODEL=nomic-embed-text:latest

# Trigger conversation summarization every N messages
MEMORY_SUMMARIZATION_INTERVAL=30

# Extract user facts every N messages for cross-session memory
MEMORY_FACT_EXTRACTION_INTERVAL=10

# =============================================================================
# Authentication (Google OAuth + JWT)
# =============================================================================
# Set to true to require Google OAuth login, false to skip auth
AUTH_REQUIRED=true

# Environment: development (HTTP cookies) or production (secure cookies, requires HTTPS)
# Use 'development' for localhost HTTP, 'production' only behind HTTPS reverse proxy
AUTH_ENV=development

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=713733202804-m4qfv1ouv27ardnbjqdcb78k1fb8bp9r.apps.googleusercontent.com

# JWT token signing secret (CHANGE THIS in production — minimum 32 characters)
JWT_SECRET_KEY=change-me-in-production-min-32-chars!!

# Access token expiry in hours
JWT_EXPIRE_HOURS=1

# Refresh token expiry in days
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================================================
# Jupiter / Solana Wallet (Optional — Phase 8)
# =============================================================================
# Enable wallet features (creates SQLite repos, registers /wallet routes)
JUPITER_ENABLED=false

# Docker image for Jupiter MCP server
JUPITER_MCP_IMAGE=localhost/jupiter-mcp:latest

# Solana RPC endpoint — devnet by default for safety
SOLANA_RPC_URL=https://api.devnet.solana.com

# Slippage tolerance in basis points (50 bps = 0.5%)
JUPITER_SLIPPAGE_BPS=50

# Jupiter MCP operation timeout in seconds
JUPITER_TIMEOUT=30

# MongoDB URI for writing trade history (optional — leave blank to disable)
MONGODB_WRITE_URI=

# =============================================================================
# Email Trade Notifications (Optional)
# =============================================================================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# =============================================================================
# Database Configuration (SQLite)
# =============================================================================
# SQLite database location (inside container)
# Data persists in ./data/ on your host machine
# Backup: cp data/chats.db data/chats.db.backup
COORDINATOR_DB_PATH=/app/data/chats.db

# =============================================================================
# Data Persistence Locations (On Your Host Machine)
# =============================================================================
# All data is stored in directories on your host:
#
#   ./data/chats.db                - SQLite database (all chat data)
#   ./personas/_summaries/         - Persona CV summaries (auto-generated)
#   ./logs/                        - Application logs
#   ollama_models (Docker volume)  - LLM models (4-10GB per model)
#
# To backup everything:
#   tar -czf mcp_backup.tar.gz data/ personas/_summaries/ logs/
#
# To restore:
#   tar -xzf mcp_backup.tar.gz
# =============================================================================
